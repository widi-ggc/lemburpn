// =============================================================
// Firestore Security Rules — MyOvertimes (Web App Manajemen Lembur Karyawan)
// =============================================================
// Aturan ini adalah LAPISAN KEAMANAN SESUNGGUHNYA aplikasi — bukan hanya
// tampilan (UI) seperti yang sudah dibuat di Dashboard/Laporan/Input Lembur.
// Meskipun seseorang mencoba mengakses Firestore langsung lewat kode lain
// di luar aplikasi ini, aturan di bawah tetap berlaku dan tidak bisa dilewati.
//
// Ringkasan aturan:
// - users        : setiap user hanya bisa membaca profilnya sendiri;
//                   Admin bisa membaca profil siapa pun.
//                   Penulisan (tambah/ubah/hapus user) hanya boleh Admin —
//                   sesuai fitur "Kelola Karyawan" yang hanya bisa diakses Admin
//                   (nomorId, nama, divisi, email, role dikelola dari sana).
// - lembur       : Karyawan hanya bisa membaca, mengubah, dan menghapus
//                   datanya sendiri (createdBy == uid miliknya).
//                   Admin bisa membaca, mengubah, dan menghapus data siapa pun.
//                   Data baru wajib dibuat dengan createdBy = uid pembuatnya
//                   sendiri (tidak bisa membuat data atas nama orang lain).
// - liburNasional: bisa dibaca oleh siapa pun yang sudah login (dipakai untuk
//                   menentukan Status Hari otomatis), tapi hanya Admin yang
//                   boleh menambah/mengubah/menghapus.
// =============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------
     * FUNGSI BANTUAN
     * --------------------------------------------------------- */

    // True jika request berasal dari user yang sudah login (punya sesi Firebase Auth)
    function isSignedIn() {
      return request.auth != null;
    }

    // Mengambil role user yang sedang login, dibaca dari dokumen users/{uid}.
    // get() di sini TIDAK melewati Security Rules lagi (aman dari infinite loop).
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // True jika user yang sedang login berperan sebagai Admin
    function isAdmin() {
      return isSignedIn() && getRole() == "admin";
    }

    /* ---------------------------------------------------------
     * KOLEKSI: users
     * --------------------------------------------------------- */
    match /users/{userId} {
      // Boleh dibaca oleh pemilik profil itu sendiri, atau oleh Admin (untuk
      // menampilkan nama karyawan di Dashboard/Laporan/Tabel Data).
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Penambahan/pengubahan/penghapusan data user hanya boleh Admin,
      // sesuai spesifikasi: akun karyawan dibuat & dikelola manual oleh Admin
      // (bukan lewat halaman registrasi).
      allow write: if isAdmin();
    }

    /* ---------------------------------------------------------
     * KOLEKSI: lembur
     * --------------------------------------------------------- */
    match /lembur/{lemburId} {
      // Membaca: pemilik data sendiri, atau Admin (lihat seluruh data)
      allow read: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());

      // Membuat data baru: wajib berstatus login, dan field createdBy pada
      // data yang dikirim harus sama dengan uid pengirim sendiri (tidak bisa
      // menitipkan/memalsukan data atas nama user lain). Field wajib lengkap.
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.keys().hasAll(
          ["tanggal", "hari", "statusHari", "jamLembur", "totalPoint", "keterangan", "createdBy", "createdAt"]
        ) &&
        request.resource.data.jamLembur is number &&
        request.resource.data.totalPoint is number;

      // Mengubah data: pemilik data sendiri (dan tidak boleh mengubah
      // kepemilikan/createdBy-nya), atau Admin (boleh mengubah data siapa pun).
      allow update: if isSignedIn() && (
        (
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy
        ) || isAdmin()
      );

      // Menghapus data: pemilik data sendiri, atau Admin
      allow delete: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    /* ---------------------------------------------------------
     * KOLEKSI: liburNasional
     * --------------------------------------------------------- */
    match /liburNasional/{liburId} {
      // Boleh dibaca siapa pun yang sudah login (dipakai untuk menentukan
      // Status Hari otomatis pada Form Input Lembur & Laporan).
      allow read: if isSignedIn();

      // Hanya Admin yang boleh menambah/mengubah/menghapus daftar libur nasional.
      allow write: if isAdmin();
    }

    /* ---------------------------------------------------------
     * DEFAULT: TOLAK SEMUA KOLEKSI LAIN YANG TIDAK DIDEFINISIKAN
     * --------------------------------------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
